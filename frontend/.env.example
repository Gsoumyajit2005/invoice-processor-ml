# Server-side Next.js BFF configuration (NEVER prefix these with NEXT_PUBLIC_)
BACKEND_API_URL=http://localhost:8000
BACKEND_SHARED_SECRET=

# Optional demo passcode login gate (leave blank to disable auth locally)
DEMO_PASSCODE=
# HMAC secret used to sign the httpOnly session cookie (set a random 32+ byte string in prod)
DEMO_AUTH_SECRET=
