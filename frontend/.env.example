# ==============================================================================
# Hybrid Document AI Invoice Processor v2 — Frontend Environment Configuration
# ==============================================================================
# (NEVER prefix backend credentials with NEXT_PUBLIC_ — these stay server-side on Next.js BFF)

# ------------------------------------------------------------------------------
# 1. Backend API Connection
# ------------------------------------------------------------------------------
# Local FastAPI backend URL:
BACKEND_API_URL=http://localhost:8000

# Modal Serverless FastAPI App URL (when deployed on Modal):
# BACKEND_API_URL=https://<your-org>--invoice-processor-fastapi-app.modal.run

# Optional shared secret header matching BACKEND_SHARED_SECRET in backend .env:
BACKEND_SHARED_SECRET=

# ------------------------------------------------------------------------------
# 2. Demo Authentication & Session Gate
# ------------------------------------------------------------------------------
# Optional demo passcode login gate (leave blank to disable login prompt for local development):
DEMO_PASSCODE=

# HMAC secret used to sign the httpOnly session cookie (set a random 32+ byte string in production):
DEMO_AUTH_SECRET=demo-secret-key-change-in-production-min-32-bytes
