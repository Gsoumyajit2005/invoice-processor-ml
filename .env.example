# ==============================================================================
# Hybrid Document AI Invoice Processor v2 — Environment Configuration
# ==============================================================================

# Database (Local Docker PostgreSQL 16 default, or Supabase / Neon Postgres URL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=invoices_db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/invoices_db

# Storage Backend ("local" or "s3")
# Local disk default stores uploads & rendered page images under backend/uploads/
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=backend/uploads

# S3-Compatible Storage (Supabase Storage S3 or Cloudflare R2 future upgrade)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Security & Rate Limiting
# Optional shared secret checked against X-Backend-Secret when set (e.g. Vercel -> Modal proxy)
BACKEND_SHARED_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=20
RATE_LIMIT_EXTRACT=20/minute

# Extraction Mode ("auto" | "local" | "cloud")
EXTRACTOR_DEFAULT_MODE=auto
LOCAL_VLM_ENABLED=true
LOCAL_VLM_DTYPE=float16
LOCAL_VLM_MAX_NEW_TOKENS=1536
# Phase 3 LoRA adapter directory (auto-ignored cleanly when absent; relative to repo root)
LOCAL_VLM_ADAPTER_DIR=models/qwen35-0.8b-invoice-lora

# Cloud Fallback / BYO-Key Defaults (never persisted to DB; UI can pass per-request X-LLM-* headers)
DEFAULT_CLOUD_PROVIDER=gemini
DEFAULT_CLOUD_MODEL=gemini/gemini-2.5-flash
DEFAULT_CLOUD_API_KEY=
