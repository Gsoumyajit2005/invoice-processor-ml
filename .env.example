# ==============================================================================
# Hybrid Document AI Invoice Processor v2 — Root Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Docker PostgreSQL 16 default:
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=invoices_db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/invoices_db

# Managed PostgreSQL Examples (Supabase / Neon):
#
# Supabase (Session Pooler or Direct):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Neon Serverless Postgres:
# DATABASE_URL=postgresql+asyncpg://[user]:[password]@[endpoint].neon.tech/neondb?ssl=require

# ------------------------------------------------------------------------------
# 2. Storage Backend Configuration ("local" | "s3")
# ------------------------------------------------------------------------------
# Local disk default stores uploads & rendered page images under backend/uploads/
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=backend/uploads

# S3-Compatible Object Storage (Cloudflare R2, Supabase Storage S3, or AWS S3):
#
# STORAGE_BACKEND=s3
# S3_BUCKET=invoices-storage
# S3_REGION=auto
#
# For Cloudflare R2:
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
#
# For Supabase Storage (S3 Protocol):
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<supabase_s3_access_key_id>
# S3_SECRET_ACCESS_KEY=<supabase_s3_secret_access_key>
#
# For AWS S3:
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<aws_access_key_id>
# S3_SECRET_ACCESS_KEY=<aws_secret_access_key>
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 3. Security, Rate Limiting & Upload Constraints
# ------------------------------------------------------------------------------
# Optional shared secret header (X-Backend-Secret) required when deployed behind Vercel BFF proxy:
BACKEND_SHARED_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.vercel.app"]
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=20
RATE_LIMIT_EXTRACT=20/minute

# ------------------------------------------------------------------------------
# 4. Extraction Engine & Local VLM Configuration
# ------------------------------------------------------------------------------
# Extraction Mode ("auto" | "local" | "cloud")
EXTRACTOR_DEFAULT_MODE=auto
LOCAL_VLM_ENABLED=true
LOCAL_VLM_DTYPE=float16
LOCAL_VLM_MAX_NEW_TOKENS=1536
# Phase 3 LoRA adapter directory (auto-ignored cleanly when absent; relative to repo root)
LOCAL_VLM_ADAPTER_DIR=models/qwen35-0.8b-invoice-lora
LOCAL_VLM_OFFLINE=true
OCR_DPI=150.0
OCR_THREADS=4

# ------------------------------------------------------------------------------
# 5. Cloud VLM Fallback Defaults (Optional server-side BYOK defaults)
# ------------------------------------------------------------------------------
DEFAULT_CLOUD_PROVIDER=gemini
DEFAULT_CLOUD_MODEL=gemini/gemini-2.5-flash
DEFAULT_CLOUD_API_KEY=
